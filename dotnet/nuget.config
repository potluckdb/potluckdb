<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Only nuget.org, whatever the machine's own NuGet settings say. The tests
       add the folder with the packages built here (test/nuget.config). -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
