<Project Sdk="Microsoft.NET.Sdk">
  <!-- Must not build: Microsoft.Data.Sqlite brings SQLitePCLRaw.bundle_e_sqlite3,
       so the app could run on e_sqlite3 (error POTLUCKDB001). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="PotluckDB.Data.Sqlite" Version="$(PotluckDBVersion)" />
  </ItemGroup>
</Project>
