<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Program.cs calls SQLitePCL.Batteries_V2.Init() first, as POTLUCKDB002 asks. -->
    <NoWarn>$(NoWarn);POTLUCKDB002</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="sqlite-net-pcl" Version="1.11.285" />
    <PackageReference Include="PotluckDB.SQLitePCLRaw" Version="$(PotluckDBVersion)" />
  </ItemGroup>
</Project>
